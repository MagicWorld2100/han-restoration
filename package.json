{
  "name": "han-restoration",
  "version": "2.1.1",
  "private": true,
  "scripts": {
    "build": "node build.mjs",
    "build:cloudflare": "npm run build && node scripts/prepare-cloudflare.mjs",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler pages deploy output/cloudflare/site --config wrangler.local.jsonc --branch main",
    "verify:cloudflare": "node scripts/verify-cloudflare.mjs",
    "test": "node --test tests/engine.test.mjs tests/scenarios.test.mjs tests/audio-cinematic.test.mjs tests/security-headers.test.mjs",
    "check:distribution": "node --test tests/public-distribution.test.mjs"
  },
  "dependencies": {
    "esbuild": "0.28.2",
    "three": "0.185.1"
  },
  "devDependencies": {
    "wrangler": "4.129.0"
  }
}
